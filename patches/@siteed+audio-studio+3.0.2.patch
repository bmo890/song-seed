+    func songNookInterleavedData(_ buffer: AVAudioPCMBuffer, commonFormat: AVAudioCommonFormat) -> Data? {
+        let channels = Int(buffer.format.channelCount)
+        guard channels > 0 else { return nil }
+        let kept = min(channels, 2)
