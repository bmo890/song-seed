+    /// A mono take after a stereo one: put the built-in mic back to its own pattern, so the
+    /// mono path does not inherit a two-channel input and keep only its left side.
+    func songNookClearStereoPattern() {
+        guard #available(iOS 14.0, *) else { return }
+        let session = AVAudioSession.sharedInstance()
+        guard let builtIn = session.availableInputs?.first(where: { $0.portType == .builtInMic }),
+              let sources = builtIn.dataSources else { return }
+        for source in sources where source.preferredPolarPattern == .stereo {
