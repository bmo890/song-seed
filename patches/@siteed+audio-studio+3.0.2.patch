+// MARK: - SongNook stereo (Pro setting, 2026-11-22)
+//
+// iOS 14+ can record stereo from two of the iPhone's built-in mics: pick a built-in data
+// source that offers the stereo polar pattern, ask for it, and say which way the phone is
+// held so left stays left. Only for the built-in mic: a headset or Bluetooth input stays
+// mono. Measurement mode keeps to the primary mic, so a stereo take uses the default mode.
+extension AudioStreamManager {
+    /// The built-in mic and its stereo-capable data source (the front one when there is a
+    /// choice: it faces whoever is watching the recorder), or nil when there is none.
+    static func songNookStereoSource(
+        in session: AVAudioSession
+    ) -> (port: AVAudioSessionPortDescription, source: AVAudioSessionDataSourceDescription)? {
+        guard #available(iOS 14.0, *) else { return nil }
+        guard let builtIn = session.availableInputs?.first(where: { $0.portType == .builtInMic }),
+              let sources = builtIn.dataSources else { return nil }
+        let stereo = sources.filter { $0.supportedPolarPatterns?.contains(.stereo) == true }
+        guard let source = stereo.first(where: { $0.orientation == .front }) ?? stereo.first else { return nil }
+        return (builtIn, source)
+    }
+
+    /// "yes" / "no", or "unknown" while the session's category hides the inputs (playback).
+    static func songNookStereoSupport() -> String {
+        guard #available(iOS 14.0, *) else { return "no" }
+        let session = AVAudioSession.sharedInstance()
+        guard let inputs = session.availableInputs,
+              let builtIn = inputs.first(where: { $0.portType == .builtInMic }),
+              builtIn.dataSources != nil else { return "unknown" }
+        return songNookStereoSource(in: session) != nil ? "yes" : "no"
+    }
+
+    /// The take will record from the built-in mic, and it can do stereo.
+    func songNookStereoRouteReady() -> Bool {
+        let session = AVAudioSession.sharedInstance()
+        if let preferred = session.preferredInput, preferred.portType != .builtInMic { return false }
+        if session.preferredInput == nil,
+           let current = session.currentRoute.inputs.first,
+           current.portType != .builtInMic { return false }
+        return Self.songNookStereoSource(in: session) != nil
+    }
+
+    /// Ask for the stereo pattern. Call after the category is set (it can reset the route).
+    func songNookApplyStereo() -> Bool {
+        guard #available(iOS 14.0, *) else { return false }
+        let session = AVAudioSession.sharedInstance()
+        guard let found = Self.songNookStereoSource(in: session) else { return false }
+        let port = found.port
+        let source = found.source
+        do {
+            try source.setPreferredPolarPattern(.stereo)
+            try port.setPreferredDataSource(source)
+            try session.setPreferredInput(port)
+            // The app is portrait-only (app.json), so the stereo image follows portrait.
+            try session.setPreferredInputOrientation(.portrait)
+            Logger.debug("AudioStreamManager", "SongNook stereo: \(source.dataSourceName) in stereo")
+            return true
+        } catch {
+            Logger.debug("AudioStreamManager", "SongNook stereo: could not apply (\(error.localizedDescription))")
+            return false
+        }
+    }
