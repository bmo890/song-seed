+    /**
+     * SongNook: where a shared file is copied. Always `cacheDir/share-intake/<uuid>.<ext>`,
+     * the extension reduced to 1-8 letters or digits (from the sender's name, else the
+     * mime type, else "bin"), and the resolved path checked to sit inside that folder.
+     * Null when it doesn't (it always should; the check is the guarantee).
+     */
+    private fun shareIntakeFile(displayName: String?, mimeType: String?): File? {
+        val intakeDir = File(context.cacheDir, "share-intake")
+        if (!intakeDir.exists() && !intakeDir.mkdirs()) return null
+        val baseName = displayName?.substringAfterLast('/')?.substringAfterLast('\\')
+        val fromName = baseName?.let { name -> if (name.contains('.')) name.substringAfterLast('.') else null }
+        val fromMime = mimeType?.let { MimeTypeMap.getSingleton().getExtensionFromMimeType(it) }
+        val safeExt = listOf(fromName, fromMime)
+            .map { ext -> ext?.lowercase()?.filter { c -> c in 'a'..'z' || c in '0'..'9' } }
+            .firstOrNull { ext -> !ext.isNullOrEmpty() && ext.length <= 8 }
+            ?: "bin"
+        val target = File(intakeDir, "${UUID.randomUUID()}.$safeExt")
+        val root = intakeDir.canonicalPath + File.separator
+        return if (target.canonicalPath.startsWith(root)) target else null
+    }
+
+    /**
+     * SongNook: a `file://` uri or a provider's `_data` column may name any path,
+     * this app's own library included. A path inside the app's private storage is
+     * refused, except the app's own share-intake copies.
+     */
+    private fun isOutsidePrivateStorage(path: String?): Boolean {
+        if (path == null) return false
+        return try {
+            val canonical = File(path).canonicalPath
+            val dataDir = File(context.applicationInfo.dataDir).canonicalPath + File.separator
+            val intake = File(context.cacheDir, "share-intake").canonicalPath + File.separator
+            canonical.startsWith(intake) || !canonical.startsWith(dataDir)
+        } catch (e: Exception) {
+            false
         }
     }
 
