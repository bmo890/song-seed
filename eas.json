{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      },
      "android": {
        "gradleCommand": ":app:assembleDevelopmentDebug"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "production"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleProductionRelease",
        "buildArtifactPaths": [
          "android/app/build/outputs/mapping/productionRelease/mapping.txt"
        ]
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production"
      },
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleProductionRelease",
        "buildArtifactPaths": [
          "android/app/build/outputs/mapping/productionRelease/mapping.txt"
        ]
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "bmostudio.dev@gmail.com",
        "appleTeamId": "PMJJ7Q9UXD",
        "sku": "songnook-ios",
        "language": "en-US",
        "ascAppId": "6810435199"
      }
    }
  }
}
