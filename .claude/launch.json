{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-dev-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start:dev"
      ],
      "port": 8081
    },
    {
      "name": "expo-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "web"
      ],
      "port": 8081
    },
    {
      "name": "songnook-send",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd server/songnook-send && npx wrangler dev --config wrangler.toml"
      ],
      "port": 8787
    },
    {
      "name": "site-preview",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8799",
        "--directory",
        "server/songnook-send/public"
      ],
      "port": 8799
    },
    {
      "name": "mockups",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8790",
        "--directory",
        "docs/product-plan/mockups"
      ],
      "port": 8790
    },
    {
      "name": "review-preview",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd server/songnook-send && node --experimental-strip-types scripts/review-preview.ts"
      ],
      "port": 8790
    }
  ]
}