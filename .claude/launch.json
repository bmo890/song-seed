{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-dev-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:dev"],
      "port": 8081
    },
    {
      "name": "expo-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "web"],
      "port": 8081
    },
    {
      "name": "songnook-send",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd server/songnook-send && npx wrangler dev --config wrangler.toml"],
      "port": 8787
    }
  ]
}
